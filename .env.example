# =====================================================================
# PASHURAKSHA AI — Environment Configuration Template
# Smart India Hackathon 2026 (SIH26128)
# =====================================================================

# Backend Configuration (FastAPI)
ENVIRONMENT=development
DEMO_MODE=true
PORT=8000
HOST=0.0.0.0

# In production (DEMO_MODE=false), SECRET_KEY MUST be a strong 32+ character random string
SECRET_KEY=change-to-a-secure-random-secret-in-production

# Database URL
# Local Development: sqlite:///./pashuraksha.db
# Production: postgresql://username:password@host:5432/pashuraksha
DATABASE_URL=sqlite:///./pashuraksha.db

# Additional CORS origins (comma-separated)
EXTRA_CORS_ORIGINS=

# Frontend Configuration (React + Vite)
# Local dev: http://127.0.0.1:8000/api/v1
# Production: https://<your-deployed-backend-domain>/api/v1 (or left empty for Vercel serverless /api/v1)
VITE_API_URL=http://127.0.0.1:8000/api/v1
