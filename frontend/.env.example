# ==============================================================================
# PASHURAKSHA AI — Frontend Environment Configuration Template
# ==============================================================================
#
# Development:
# Leave empty to use local Vite dev server proxy or direct localhost connection:
# VITE_API_URL=http://127.0.0.1:8000/api/v1
#
# Production (Vercel / Cloudflare / Netlify):
# Option A: Set to the full URL of your deployed FastAPI backend:
# VITE_API_URL=https://pashuraksha-ai-backend.onrender.com/api/v1
#
# Option B: Omit VITE_API_URL and use relative /api/v1 (handled automatically by vercel.json rewrites)
#
VITE_API_URL=http://127.0.0.1:8000/api/v1
