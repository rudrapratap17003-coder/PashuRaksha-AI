# ==============================================================================
# PASHURAKSHA AI — Configuration Environment Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT
# ------------------------------------------------------------------------------
# Set to 'development' for local coding, 'production' for live deployment
ENVIRONMENT="development"
PROJECT_NAME="PASHURAKSHA AI"
API_V1_STR="/api/v1"
PORT=8000
HOST="0.0.0.0"

# ------------------------------------------------------------------------------
# 2. DEMO MODE TOGGLE
# ------------------------------------------------------------------------------
# Set to 'true' for local SIH evaluation/demonstration with synthetic seeded data.
# Set to 'false' for production deployment to enforce strict authentication & DB.
DEMO_MODE=false

# ------------------------------------------------------------------------------
# 3. JWT AUTHENTICATION SECURITY
# ------------------------------------------------------------------------------
# In production, SECRET_KEY MUST be a long cryptographically secure random string.
# Example generation: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# 4. PERSISTENT DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Development (DEMO_MODE=true): Can fallback to SQLite (pashuraksha.db)
# Production (DEMO_MODE=false): PostgreSQL is mandatory!
# Format: postgresql://user:password@host:5432/pashuraksha_db
DATABASE_URL=postgresql://user:password@host:5432/pashuraksha_db

# ------------------------------------------------------------------------------
# 5. CROSS-ORIGIN RESOURCE SHARING (CORS)
# ------------------------------------------------------------------------------
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000"
EXTRA_CORS_ORIGINS="https://pashu-raksha-ai.vercel.app"
