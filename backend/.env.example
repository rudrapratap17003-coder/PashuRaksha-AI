# ==============================================================================
# PASHURAKSHA AI — Configuration Environment Template
# ==============================================================================

# Application Environment: 'development' | 'production'
ENVIRONMENT="development"
PROJECT_NAME="PASHURAKSHA AI"
API_V1_STR="/api/v1"
PORT=8000
HOST="0.0.0.0"

# DEMO_MODE: Set to 'true' for local SIH evaluation/demonstration.
# For production deployment, set to 'false' to enforce strict security with zero fallback.
DEMO_MODE=false

# JWT Authentication Secret Key
# Production must provide a secure unique random secret.
# Never commit actual production secrets.
# Example:
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Local Development (DEMO_MODE=true): Can use SQLite fallback
# Production (DEMO_MODE=false): PostgreSQL is mandatory:
DATABASE_URL=postgresql://user:password@host:5432/pashuraksha_db

# CORS Configuration
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
EXTRA_CORS_ORIGINS="https://pashu-raksha-ai.vercel.app"
